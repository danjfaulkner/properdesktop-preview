#. TRANSLATORS: the current match and the number of matches, such as "2 of 5".
#. TRANSLATORS: the shown image's place among the window's images, such as "3 of 24".
#: src/views/pdfpage.cpp src/views/previewwindow.cpp
#, python-brace-format
msgid "{index} of {count}"
msgstr "{index} dari {count}"

#: src/views/previewwindow.cpp properdesktop-preview.desktop
msgid "Preview"
msgstr "Pratinjau"

#. TRANSLATORS: after a PDF's name on the header's line: the page most in sight and the number of pages.
#: src/views/previewwindow.cpp
#, python-brace-format
msgid "Page {page} of {count}"
msgstr "Halaman {page} dari {count}"

#: src/views/previewwindow.cpp
#, python-brace-format
msgid "Could not rotate {name}: it cannot be read as a JPEG or PNG image"
msgstr "Tidak dapat memutar {name}: file tidak dapat dibaca sebagai gambar JPEG atau PNG"

#. TRANSLATORS: {reason} is the system's error text, such as "Permission denied".
#: src/views/previewwindow.cpp
#, python-brace-format
msgid "Could not rotate {name}: {reason}"
msgstr "Tidak dapat memutar {name}: {reason}"

