#, python-brace-format
msgid "{index} of {count}"
msgstr "{index} de {count}"

#: src/views/previewwindow.cpp properdesktop-preview.desktop
msgid "Preview"
msgstr "Pré-visualização"

#. TRANSLATORS: after a PDF's name on the header's line: the page most in sight and the number of pages.
#: src/views/previewwindow.cpp
#, python-brace-format
